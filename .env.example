# ============================================================
# Relay — Environment Variables
# Copy to .env.local and fill in real values.
# ============================================================

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (Supabase Postgres) ---
# pooled connection for runtime
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relay
# direct connection for migrations
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/relay

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_REASONING=claude-sonnet-4-6
ANTHROPIC_MODEL_SUMMARY=claude-sonnet-4-6

# --- Deepgram (STT) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general

# --- Cartesia (TTS - default) ---
CARTESIA_API_KEY=
CARTESIA_VERSION=2025-04-16
CARTESIA_MODEL=sonic-3

# --- ElevenLabs (TTS - premium SKU) ---
ELEVENLABS_API_KEY=

# --- LiveKit ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_SIP_TRUNK_ID=

# --- Twilio (Telephony) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_SIP_DOMAIN=

# --- Cal.com (Calendar) ---
CALCOM_API_BASE=https://api.cal.com/v2
CALCOM_CLIENT_ID=
CALCOM_CLIENT_SECRET=
CALCOM_WEBHOOK_SECRET=

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Resend (transactional email for invites) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=invites@relay.example

# --- Observability ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Worker (agent) ---
# Public URL where the agent worker exposes a health endpoint / webhook target.
WORKER_PUBLIC_URL=http://localhost:3001
# Shared secret used by the Next.js app to authenticate calls to the worker.
WORKER_SHARED_SECRET=
