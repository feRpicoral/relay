# ============================================================
# Relay — Environment Variables
# Copy to .env.local and fill in real values.
# ============================================================

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Host shown in the landing page's fake browser chrome (display only)
NEXT_PUBLIC_APP_DOMAIN=app.relay.so

# --- Database (Supabase Postgres) ---
# pooled connection for runtime
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relay
# direct connection for migrations
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/relay

# --- Supabase ---
# New API key style only (publishable + secret). Get them from the Supabase
# dashboard under Project Settings, API Keys. The legacy anon/service_role
# names are not read.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SUMMARY=claude-sonnet-4-6

# --- Deepgram (STT) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Cartesia (TTS - default) ---
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3

# --- ElevenLabs (TTS - premium SKU, optional) ---
ELEVENLABS_API_KEY=

# --- LiveKit ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
# SIP inbound trunk in LiveKit Cloud. Each tenant's Twilio account sends inbound
# calls to this trunk; the worker resolves which tenant owns the call by E.164.
# When a tenant attaches a Twilio number via the dashboard, the app extends this
# trunk's allow-list to include that E.164.
LIVEKIT_SIP_INBOUND_TRUNK_ID=

# --- Twilio (Telephony) ---
# Twilio credentials are stored per-org in the database (TwilioConnection).
# Each org admin pastes an API Key SID + secret in Settings, Telefonia. The app
# uses those creds to provision their Elastic SIP Trunk and to register a
# per-org LiveKit outbound trunk that carries calls back to their account.

# --- Cal.com (Calendar) ---
# API keys are stored per-org in the database. Each clinic admin pastes their
# own `cal_live_...` key in Settings, Calendar.
CALCOM_API_BASE=https://api.cal.com/v2

# --- App secrets (server-only encryption) ---
# 32+ char random string used by lib/crypto.ts to AES-256-GCM encrypt secrets
# stored in the database (Twilio auth token, future provider credentials).
# Generate with: openssl rand -base64 48
ENCRYPTION_KEY=

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Resend (transactional email for invites) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=invites@relay.example

# --- Observability ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
